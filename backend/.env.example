# Cadena de conexión a PostgreSQL (driver síncrono psycopg2).
DATABASE_URL=postgresql+psycopg2://reserva_app:elegi-una-password@localhost:5432/reserva_vehiculos

# Credenciales de administración (HTTP Basic, ver Block 3).
ADMIN_USERNAME=admin
# Hash bcrypt de la contraseña del admin, generado con:
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('tu-password'))"
ADMIN_PASSWORD_HASH=

# Origen exacto del frontend, para configurar CORS (nunca "*").
FRONTEND_ORIGIN=http://localhost:5173
